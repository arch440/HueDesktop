<Application
    x:Class="HueDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <Color x:Key="SystemAccentColor">#D99A2B</Color>
            <Color x:Key="HueAccentColor">#D99A2B</Color>
            <SolidColorBrush x:Key="HueAccentBrush" Color="{StaticResource HueAccentColor}" />
            <SolidColorBrush x:Key="HueCanvasBrush" Color="#F5F3EE" />
            <SolidColorBrush x:Key="HueCardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="HueSubtleBrush" Color="#FAF8F3" />
            <SolidColorBrush x:Key="HueAccentSoftBrush" Color="#FFF4DE" />
            <SolidColorBrush x:Key="HueTextBrush" Color="#292821" />
            <SolidColorBrush x:Key="HueMutedTextBrush" Color="#77766F" />
            <SolidColorBrush x:Key="HueBorderBrush" Color="#E8E3D9" />
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
