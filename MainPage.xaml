<Page
    x:Class="HueDesktop.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:tb="using:H.NotifyIcon"
    RequestedTheme="Light">
    <Grid Background="{StaticResource HueCanvasBrush}">
        <ScrollViewer
            x:Name="MainScrollViewer"
            Background="{StaticResource HueCanvasBrush}"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Enabled">
            <Border
                HorizontalAlignment="Center"
                Padding="38,26"
                Width="687">
                <StackPanel Width="611" Spacing="20">
                    <Grid ColumnSpacing="18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock
                                CharacterSpacing="180"
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource HueAccentBrush}"
                                Text="HUE HOME" />
                            <TextBlock
                                FontSize="34"
                                FontWeight="SemiBold"
                                Foreground="{StaticResource HueTextBrush}"
                                Text="Lighting" />
                            <TextBlock
                                Foreground="{StaticResource HueMutedTextBrush}"
                                Text="A comfortable light for every room." />
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Background="{StaticResource HueAccentSoftBrush}"
                            BorderBrush="{StaticResource HueBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="16,12"
                            VerticalAlignment="Center">
                            <StackPanel Spacing="2">
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource HueTextBrush}"
                                    Text="Whole home" />
                                <ToggleSwitch
                                    x:Name="HomePowerToggle"
                                    AutomationProperties.Name="Home lights power"
                                    FontSize="16"
                                    IsEnabled="False"
                                    MinWidth="130"
                                    OffContent="Off"
                                    OnContent="On"
                                    Toggled="HomePowerToggle_Toggled"
                                    ToolTipService.ToolTip="Control the bridge's shared home lighting group." />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border
                        x:Name="ConnectionPanel"
                        Background="{StaticResource HueCardBrush}"
                        BorderBrush="{StaticResource HueBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="20">
                        <StackPanel Spacing="14">
                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="18"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource HueTextBrush}"
                                    Text="Bridge connection" />
                                <TextBlock
                                    Foreground="{StaticResource HueMutedTextBrush}"
                                    Text="Connect to your Hue Bridge to manage rooms and lights." />
                            </StackPanel>

                            <Grid ColumnSpacing="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource HueMutedTextBrush}"
                                        Text="BRIDGE IP ADDRESS" />
                                    <TextBox
                                        x:Name="BridgeIpBox"
                                        PlaceholderText="192.168.1.206"
                                        Text="192.168.1.206" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="6">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{StaticResource HueMutedTextBrush}"
                                        Text="APPLICATION KEY" />
                                    <PasswordBox
                                        x:Name="ApplicationKeyBox"
                                        PlaceholderText="Enter the bridge application key" />
                                </StackPanel>
                            </Grid>

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CheckBox
                                    x:Name="RememberConnectionCheckBox"
                                    Content="Remember IP and key on this PC"
                                    IsChecked="True"
                                    VerticalAlignment="Center" />
                                <Button
                                    x:Name="ConnectButton"
                                    Grid.Column="1"
                                    Click="ConnectButton_Click"
                                    Content="Connect"
                                    MinWidth="120"
                                    Padding="18,8"
                                    Background="{StaticResource HueAccentBrush}"
                                    Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock
                        x:Name="StatusTextBlock"
                        FontSize="13"
                        Foreground="{StaticResource HueMutedTextBrush}"
                        TextWrapping="Wrap" />
                    <Button
                        x:Name="ChangeConnectionButton"
                        Click="ChangeConnectionButton_Click"
                        Content="Change connection"
                        Foreground="{StaticResource HueAccentBrush}"
                        HorizontalAlignment="Left"
                        Visibility="Collapsed" />
                    <ContentControl
                        x:Name="RoomsContentControl"
                        HorizontalContentAlignment="Stretch">
                        <StackPanel
                            x:Name="RoomsPanel"
                            HorizontalAlignment="Stretch"
                            Spacing="14" />
                    </ContentControl>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <tb:TaskbarIcon
            x:Name="TrayIcon"
            LeftClickCommand="{x:Bind OpenWindowCommand}"
            NoLeftClickDelay="True"
            ToolTipText="Hue lights">
            <tb:TaskbarIcon.IconSource>
                <tb:GeneratedIconSource Text="H" Foreground="Orange" FontSize="32" />
            </tb:TaskbarIcon.IconSource>
            <tb:TaskbarIcon.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem Command="{x:Bind OpenWindowCommand}" Text="Open Hue lights" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem Command="{x:Bind ExitApplicationCommand}" Text="Close" />
                </MenuFlyout>
            </tb:TaskbarIcon.ContextFlyout>
        </tb:TaskbarIcon>
    </Grid>
</Page>
